<Window x:Class="DragAndDrop_Radosteva.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обрезка фотографии" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Загрузить фото" Width="120" Margin="0,0,10,0" Click="Load_Click"/>
            <Button Content="Обрезать" Width="120" Click="Crop_Click"/>
        </StackPanel>

        <Canvas x:Name="canvas" Grid.Row="1" Width="400" Height="300" VerticalAlignment="Top" HorizontalAlignment="Left"
                Background="LightGray" ClipToBounds="True" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp">
            <Image x:Name="photo" Stretch="Fill"/>
            <Rectangle x:Name="frame" Width="150" Height="100" Canvas.Left="20" Canvas.Top="20"
                       Stroke="Red" StrokeThickness="2" StrokeDashArray="4 2" Fill="#33FFFFFF"
                       Cursor="SizeAll" MouseDown="Frame_MouseDown"/>
            <Rectangle x:Name="handle" Width="12" Height="12" Fill="Red"
                       Cursor="SizeNWSE" MouseDown="Handle_MouseDown"/>
        </Canvas>

        <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" BorderBrush="Gray" BorderThickness="1">
            <Image x:Name="result" Stretch="Uniform"/>
        </Border>
    </Grid>
</Window>
